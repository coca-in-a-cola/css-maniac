{% macro img(p, sizes, cls="", eager=false, w=1200) %}
<img class="{{ cls }}" src="{{ p.src(w) }}" srcset="{{ p.srcset }}" sizes="{{ sizes }}" alt="{{ p.alt }}"{% if not eager %} loading="lazy"{% endif %} decoding="async">
{% endmacro %}

{% macro status(s) %}
<span class="status status--{{ s }}">{{ s | statusLabel }}</span>
{% endmacro %}

{% macro projectCard(pr, photos, headingLevel=3) %}
<article class="project">
  <div class="project__media">{{ img(photos[pr.photo], "(min-width: 64em) 24rem, (min-width: 40em) 45vw, 100vw", "project__img", false, 800) }}</div>
  <div class="project__body">
    <p class="project__meta">{{ status(pr.status) }} <span class="project__period">{{ pr.period }}</span></p>
    <h{{ headingLevel }} class="project__title">{{ pr.title }}</h{{ headingLevel }}>
    <p class="project__summary">{{ pr.summary }}</p>
    {% if pr.facts %}
    <ul class="project__facts">
      {% for f in pr.facts %}<li>{{ f }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if pr.progress %}
    <div class="progress">
      <p class="progress__label"><span>Выполнено</span> <strong>{{ pr.progress }} %</strong></p>
      <progress class="progress__bar" max="100" value="{{ pr.progress }}" aria-label="Выполнение проекта «{{ pr.title }}»">{{ pr.progress }} %</progress>
    </div>
    {% endif %}
  </div>
</article>
{% endmacro %}

{% macro newsMeta(n) %}
<p class="news-meta"><time datetime="{{ n.date }}">{{ n.date | ruDate }}</time><span class="news-meta__tag">{{ n.tag }}</span></p>
{% endmacro %}

{% macro docLink(d, pageUrl) %}
<a class="doc-file" href="{{ ('files/' + d.file) | rel(pageUrl) }}" download>
  <span class="doc-file__ext doc-file__ext--{{ d.ext | lower }}">{{ d.ext }}</span>
  <span class="doc-file__text">Скачать<span class="visually-hidden"> «{{ d.title }}»,</span> <span class="doc-file__size">{{ d.size }}</span></span>
</a>
{% endmacro %}

{% macro docCompact(d, pageUrl) %}
<li class="doc-compact">
  <div class="doc-compact__main">
    <p class="doc-compact__meta"><span class="doc-num">№ {{ d.number }}</span> · <time datetime="{{ d.date }}">{{ d.date | numDate }}</time></p>
    <p class="doc-compact__title">{{ d.title }}</p>
  </div>
  {{ docLink(d, pageUrl) }}
</li>
{% endmacro %}
