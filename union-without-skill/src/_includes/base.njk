<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}{% if navKey != "home" %} — профсоюз «{{ site.short }}»{% endif %}</title>
  <meta name="description" content="{{ description or site.full }}">
  <link rel="icon" href="{{ 'assets/favicon.svg' | rel(page.url) }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ 'assets/css/main.css' | rel(page.url) }}">
  <script>document.documentElement.classList.add("js");</script>
</head>
<body class="page-{{ navKey }}">
  <a class="skip-link" href="#main">Перейти к содержанию</a>

  <div class="topbar">
    <div class="wrap topbar__inner">
      <p class="topbar__item">Горячая линия: <a href="tel:{{ site.hotlineHref }}">{{ site.hotline }}</a> <span class="topbar__muted">— бесплатно по России</span></p>
      <p class="topbar__item topbar__mail"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>
  </div>

  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="brand" href="{{ 'index.html' | rel(page.url) }}"{% if navKey == "home" %} aria-current="page"{% endif %}>
        {% include "logo.njk" %}
        <span class="brand__text">
          <span class="brand__name">Сцепка</span>
          <span class="brand__desc">{{ site.descriptor }}</span>
        </span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-toggle__bars" aria-hidden="true"></span>
        Меню
      </button>
      <nav class="site-nav" id="site-nav" aria-label="Основная навигация">
        <ul class="site-nav__list">
          {% for item in site.nav %}
          <li><a class="site-nav__link" href="{{ item.href | rel(page.url) }}"{% if item.key == navKey %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
        <a class="button button--small site-nav__join" href="{{ 'about.html' | rel(page.url) }}#join">Вступить в профсоюз</a>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__grid">
      <div class="site-footer__about">
        <p class="site-footer__brand">{% include "logo.njk" %} <span>Сцепка</span></p>
        <p>{{ site.full }}. Работаем с {{ site.founded }} года.</p>
      </div>
      <div>
        <h2 class="site-footer__title">Контакты</h2>
        <ul class="site-footer__list">
          <li>{{ site.address }}</li>
          <li><a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></li>
          <li><a href="tel:{{ site.hotlineHref }}">{{ site.hotline }}</a> — горячая линия</li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="site-footer__title">Разделы</h2>
        <ul class="site-footer__list">
          {% for item in site.nav %}
          <li><a href="{{ item.href | rel(page.url) }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="wrap">
      <div class="site-footer__legal">
        <p>Демонстрационный сайт. Организация, люди, предприятия и документы вымышлены; совпадения случайны.</p>
        <p>Фотографии: <a href="https://unsplash.com/license">Unsplash</a>, авторы указаны в подписях.</p>
      </div>
    </div>
  </footer>

  <script src="{{ 'assets/js/site.js' | rel(page.url) }}" defer></script>
</body>
</html>
