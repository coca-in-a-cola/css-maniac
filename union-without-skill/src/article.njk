---
layout: base.njk
pagination:
  data: news
  size: 1
  alias: n
permalink: "news/{{ n.slug }}.html"
navKey: news
eleventyComputed:
  title: "{{ n.title }}"
  description: "{{ n.lead }}"
---
{% from "macros.njk" import img, newsMeta, docCompact %}

<article class="article">
  <header class="article__head wrap">
    <nav class="crumbs" aria-label="Вы здесь">
      <ol>
        <li><a href="{{ 'index.html' | rel(page.url) }}">Главная</a></li>
        <li><a href="{{ 'news.html' | rel(page.url) }}">Новости</a></li>
      </ol>
    </nav>
    {{ newsMeta(n) }}
    <h1 class="article__title">{{ n.title }}</h1>
    <p class="article__lead">{{ n.lead }}</p>
  </header>

  <figure class="article__figure wrap">
    {{ img(photos[n.photo], "(min-width: 76em) 72rem, 100vw", "article__img", true, 1800) }}
    <figcaption class="photo-credit">Фото: {{ photos[n.photo].credit }}. Иллюстрация.</figcaption>
  </figure>

  <div class="wrap article__layout">
    <div class="prose">
      {{ n.body | safe }}
    </div>
    <aside class="article__aside">
      {% set rel = documents.items | docsByNumbers(n.related) %}
      {% if rel.length %}
      <section class="aside-block">
        <h2 class="aside-block__title">Документы по теме</h2>
        <ul class="doc-compact-list doc-compact-list--aside">
          {% for d in rel %}{{ docCompact(d, page.url) }}{% endfor %}
        </ul>
      </section>
      {% endif %}
      <section class="aside-block">
        <h2 class="aside-block__title">Другие новости</h2>
        <ul class="aside-news">
          {% for o in (news | except(n.slug)).slice(0, 3) %}
          <li>
            <time datetime="{{ o.date }}">{{ o.date | ruDate }}</time>
            <a href="{{ o.slug }}.html">{{ o.title }}</a>
          </li>
          {% endfor %}
        </ul>
      </section>
    </aside>
  </div>
</article>
